# ==============================================================================
#  MeetIntel — Environment Configuration (Gemini Edition)
#  Copy this file to .env → fill in your keys → never commit .env to git
# ==============================================================================

# ── GOOGLE AI STUDIO (Gemini Flash / Pro Vision + text-embedding-004) ─────────
# Dashboard: https://aistudio.google.com/app/apikey → "Get API key"
# Used for: action detection, vision analysis, debrief generation, embeddings
GOOGLE_API_KEY=

# ── DEEPGRAM (Real-Time Speech-to-Text) ───────────────────────────────────────
# Dashboard: https://console.deepgram.com → "API Keys" → Create a new key
DEEPGRAM_API_KEY=

# ── SUPABASE (PostgreSQL + pgvector) ──────────────────────────────────────────
# Dashboard: https://supabase.com/dashboard → Your Project → Settings → API
# Use the "service_role" key (NOT the anon key — it bypasses RLS for backend use)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# ── ZAPIER WEBHOOK (Jira / Notion post-call automation) ───────────────────────
# Guide: https://zapier.com/app/zaps → New Zap → Trigger: Webhooks by Zapier → Catch Hook
ZAPIER_WEBHOOK_URL=

# ── N8N WEBHOOK (self-hosted alternative to Zapier) ───────────────────────────
N8N_WEBHOOK_URL=

# ── JIRA / NOTION DIRECT WEBHOOKS (optional) ──────────────────────────────────
JIRA_WEBHOOK_URL=
NOTION_WEBHOOK_URL=

# ── SERVER CONFIG ──────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# "development" | "production"
APP_ENV=development
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,app://.,file://

# ── VISION / AI TUNING ────────────────────────────────────────────────────────
# Fraction of 64-bit dHash that must differ before treating as a new slide
# Lower = more sensitive (0.05–0.30 recommended)
SLIDE_CHANGE_THRESHOLD=0.15
# Cosine similarity floor for Meeting Debt RAG query (0.70–0.90 recommended)
DEBT_SIMILARITY_THRESHOLD=0.78
# Number of past meetings to search for debt items
DEBT_MEETING_WINDOW=3
# Number of final transcript segments to keep in the sliding action-detection window
ACTION_WINDOW_SIZE=20
# Run action detection every N final segments
ACTION_TRIGGER_INTERVAL=5

# ── DEEPGRAM MODEL CONFIG ──────────────────────────────────────────────────────
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_SAMPLE_RATE=16000

# ── GEMINI MODEL CONFIG ────────────────────────────────────────────────────────
# Live tasks — used during the meeting for action detection (low latency, fast)
GEMINI_TEXT_MODEL=gemini-1.5-flash
# Final debrief — used post-meeting for one-shot synthesis (quality > speed)
GEMINI_DEBRIEF_MODEL=gemini-1.5-pro
# Vision model (slide analysis with multimodal input)
GEMINI_VISION_MODEL=gemini-1.5-pro
# Embedding model (Meeting Debt RAG)
GEMINI_EMBED_MODEL=models/text-embedding-004
