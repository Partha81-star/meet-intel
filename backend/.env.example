# Local setup: no keys needed for the synthetic demo.
APP_ENV=development
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,app://.,file://
# SQLite is configured automatically; Docker uses PostgreSQL.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/meetintel
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_DEBRIEF_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_SAMPLE_RATE=16000
ACTION_TRIGGER_INTERVAL=3
