{$SITE_ADDRESS:http://localhost} {
    basic_auth {
        {$SITE_USERNAME:admin} {$SITE_PASSWORD_HASH}
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
    handle_path /api/* {
        reverse_proxy backend:8000
    }
    handle {
        reverse_proxy frontend:3000
    }
}
